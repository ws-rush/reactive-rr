    "oxlint": "^1.74.0",
    "react-scan": "^0.5.7",
    "remix-flat-routes": "^0.8.5",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "unplugin-fonts": "^2.0.0",
    "unplugin-icons": "^23.0.1",
    "vite": "8.1.4",
    "vite-imagetools": "^10.0.1",
