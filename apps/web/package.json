{
  "name": "@reactive-rr/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start:client": "vite preview",
    "start:server": "react-router-serve ./build/server/index.js",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "check": "oxfmt . --write && oxlint . --fix",
    "typecheck": "react-router typegen && tsc",
    "messages:extract": "lingui extract",
    "messages:compile": "lingui compile",
    "test": "vitest",
    "test:unit": "vitest",
    "test:once": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@lingui/core": "^6.5.0",
    "@lingui/react": "^6.5.0",
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "isbot": "^5.2.0",
    "lingui-rr": "^0.1.1",
    "mitt": "^3.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^8.0.1",
    "@fontsource/lato": "^5.2.7",
    "@iconify-json/carbon": "^1.2.24",
    "@julr/vite-plugin-validate-env": "^2.2.2",
    "@lingui/cli": "^6.5.0",
    "@lingui/conf": "^6.5.0",
    "@lingui/format-po": "^6.5.0",
    "@lingui/vite-plugin": "^6.5.0",
    "@msw/source": "^0.6.1",
    "@react-router/dev": "^8.3.0",
    "@react-router/remix-routes-option-adapter": "^8.3.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
